# Copy to .env for local use; never commit it.
PROTONMAIL_BRIDGE_USERNAME=you@proton.me
PROTONMAIL_BRIDGE_PASSWORD=the-password-shown-in-proton-bridge

# Optional
# PROTONMAIL_BRIDGE_HOST=127.0.0.1
# PROTONMAIL_BRIDGE_IMAP_PORT=1143
# PROTONMAIL_BRIDGE_IMAP_SECURITY=starttls
# PROTONMAIL_BRIDGE_TIMEOUT=30
# PROTONMAIL_BRIDGE_VERIFY_TLS=false
